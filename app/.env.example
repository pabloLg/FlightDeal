NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-start>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-status>
CRON_SECRET=<random-secret-for-scheduler-cron>

# Flight sources, comma separated, in failover order. First non-degraded wins.
# A legitimate "no flights" stops the chain. mock is dropped automatically when
# a real source is listed, so synthetic prices never mix with real ones.
# Known names: mock | serpapi | ignav   (google arrives with the Playwright wiring)
FLIGHT_SOURCES=mock
# Optional: real providers stay disabled when their key is absent.
SERPAPI_API_KEY=
IGNAV_API_KEY=
