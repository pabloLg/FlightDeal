NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-start>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-status>
CRON_SECRET=<random-secret-for-scheduler-cron>

# Flight sources, comma separated, in failover order. First non-degraded wins.
# A legitimate "no flights" stops the chain. mock is dropped automatically when
# a real source is listed, so synthetic prices never mix with real ones.
# Known names: mock | google_flights | serpapi | ignav
# Local dev keeps only mock: google_flights needs a real browser and scrapes
# live Google Flights. Production runs the full chain.
FLIGHT_SOURCES=mock
# Optional: real providers stay disabled when their key is absent.
SERPAPI_API_KEY=
IGNAV_API_KEY=

# google_flights needs a Chromium binary. Self-hosted only: point it at any
# Chrome/Chromium (or a `playwright install chromium` binary). Unset on Vercel,
# where the browser comes from @sparticuz/chromium and is unpacked to /tmp.
CHROMIUM_PATH=
# Wall clock one search may take across the whole failover chain (ms). The
# platform kills the invocation past its own cap (60 s on Vercel Hobby) and the
# execution is left with no result to audit, so the chain stops asking for new
# sources once this is spent. Paid API sources also carry a 10 s request cap.
SCRAPE_BUDGET_MS=30000
